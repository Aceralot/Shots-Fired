[sub_resource type="GDScript" id="GDScript_av3cl"]
script/source = "extends CharacterBody2D

var health = 100.0

@export var SPEED = 300.0

signal health_depleted

var helath = 100

func _process(delta: float) -> void:
	pass


func _physics_process(delta) -> void:
	var direction = Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")
	    
	#INVERSION APPLIED HERE
	direction.y *= 1
	
	velocity = direction * SPEED
	move_and_slide()
	
	const DAMAGE_RATE = 5.0
	var overlapping_mobs = $HitBox.get_overlapping_areas()
	if overlapping_mobs.size() > 0:
		health -= DAMAGE_RATE * overlapping_mobs.size() * delta
		%ProgressBar.value = health
		if health <= 0.0:
			health_depleted.emit()
			
	
	
	#// play animation// unhashtag when animations are ready
	#if velocity.length() > 0.0:
		#$AnimationPlayer.play_walk_animation()
	#else:
		#$AnimationPlayer.play_idle_animation()
	

	
"

